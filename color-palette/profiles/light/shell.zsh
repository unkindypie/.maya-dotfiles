# Generated shell colors; sourced at the next prompt.
export MAYA_THEME_MODE=light
export SOBOLE_THEME_MODE=light
export FZF_DEFAULT_OPTS="${MAYA_FZF_BASE_OPTS} --color=bg:#fff5dc,fg:#3b2322,bg+:#e6b5c6,fg+:#50313e,hl:#835f70,hl+:#50313e,pointer:#a95878,marker:#3d5d4d,border:#aa9588"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#74675e'
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#009600'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#009600'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#009600'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#cc0000'
ZSH_HIGHLIGHT_STYLES[path]='fg=#0087cc'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg=#d06b00'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg=#d06b00'
