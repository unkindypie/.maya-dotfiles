{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 3,
  "margin-top": 7,
  "margin-left": 10,
  "margin-right": 10,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/menu",
    "hyprland/workspaces",
    "custom/kool-help",
    "custom/kool-settings",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "custom/keyboard-layout"
  ],
  "modules-right": [
    "mpris",
    "cpu",
    "memory",
    "network",
    "backlight",
    "custom/kool-nightlight",
    "battery",
    "pulseaudio",
    "idle_inhibitor",
    "custom/notifications",
    "tray",
    "custom/power"
  ],
  "custom/menu": {
    "format": "󰄛",
    "tooltip-format": "Applications · right-click for terminal",
    "on-click": "~/.local/bin/maya-bar-action menu",
    "on-click-right": "kitty"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○",
      "urgent": "!"
    },
    "on-click": "activate",
    "sort-by-number": true
  },
  "hyprland/window": {
    "max-length": 35,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a  %d %b  ·  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "mpris": {
    "format": "{player_icon} {title}",
    "format-paused": "⏸ {title}",
    "player-icons": {
      "default": "♪"
    },
    "max-length": 23
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname} · {ipaddr}",
    "on-click": "~/.local/bin/maya-bar-action network"
  },
  "backlight": {
    "format": "󰃠 {percent}%",
    "on-scroll-up": "~/.local/bin/maya-bar-action bright-up",
    "on-scroll-down": "~/.local/bin/maya-bar-action bright-down"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "states": {
      "warning": 25,
      "critical": 10
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "~/.local/bin/maya-bar-action mute",
    "on-click-right": "pavucontrol",
    "on-click-middle": "~/.local/bin/maya-bar-action mic",
    "on-scroll-up": "~/.local/bin/maya-bar-action volume-up",
    "on-scroll-down": "~/.local/bin/maya-bar-action volume-down"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    }
  },
  "custom/notifications": {
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂜"
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "tray": {
    "spacing": 6,
    "icon-size": 16
  },
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Session controls · right-click to lock",
    "on-click": "~/.local/bin/maya-bar-action power",
    "on-click-right": "~/.local/bin/maya-bar-action lock"
  },
  "custom/kool-help": {
    "exec-if": "test -x \"$HOME/.config/hypr/scripts/KeyHints.sh\" && command -v yad >/dev/null",
    "exec": "printf '󰋖'",
    "interval": 60,
    "format": "{}",
    "tooltip-format": "KooL help · click: quick tips · right-click: keybindings",
    "on-click": "\"$HOME/.config/hypr/scripts/KeyHints.sh\"",
    "on-click-right": "test ! -x \"$HOME/.config/hypr/scripts/KeyBinds.sh\" || \"$HOME/.config/hypr/scripts/KeyBinds.sh\""
  },
  "custom/kool-settings": {
    "exec-if": "test -x \"$HOME/.config/hypr/scripts/Kool_Quick_Settings.sh\" && command -v rofi >/dev/null",
    "exec": "printf ''",
    "interval": 60,
    "format": "{}",
    "tooltip-format": "KooL quick settings",
    "on-click": "\"$HOME/.config/hypr/scripts/Kool_Quick_Settings.sh\""
  },
  "custom/kool-nightlight": {
    "exec-if": "test -x \"$HOME/.config/hypr/scripts/Hyprsunset.sh\" && command -v hyprsunset >/dev/null",
    "exec": "\"$HOME/.config/hypr/scripts/Hyprsunset.sh\" status",
    "interval": 3,
    "return-type": "json",
    "format": "{text}",
    "tooltip-format": "KooL blue-light filter · click to toggle",
    "on-click": "\"$HOME/.config/hypr/scripts/Hyprsunset.sh\" toggle"
  },
  "custom/keyboard-layout": {
    "exec": "~/.local/bin/maya-keyboard-layout --watch",
    "return-type": "json",
    "format": "{text}",
    "on-click": "~/.local/bin/maya-keyboard-layout --next",
    "exec-on-event": false,
    "restart-interval": 1
  }
}
