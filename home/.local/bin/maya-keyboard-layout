#!/usr/bin/env python3
"""Show or watch the active keyboard layout, or switch it with --next."""
import argparse
import json
import os
import socket

# XKB country layouts use ISO country codes; non-country layouts get a globe.
COUNTRY_LAYOUTS = frozenset("""
al am at au az ba bd be bg br bt bw by ca cd ch cm cn cz de dk dz ee es et fi
fo fr gb ge gh gn gr hr hu id ie il in iq ir is it jp ke kg kh kr kz la lk
lt lv ma md me mk ml mm mn mt mv my ng nl no np ph pk pl pt ro rs ru se si
sk sn sy th tj tm tr tw tz ua us uz vn za
""".split())


def layout_flag(layout):
    if layout in COUNTRY_LAYOUTS:
        return ''.join(chr(0x1F1E6 + ord(letter) - ord('a')) for letter in layout)
    return '🌐'


def socket_path(name):
    runtime = os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    return f"{runtime}/hypr/{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/{name}"


def request(command):
    # Use Hyprland IPC directly to avoid launching hyprctl on every click/event.
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(2)
        connection.connect(socket_path('.socket.sock'))
        connection.sendall(command.encode())
        chunks = []
        while chunk := connection.recv(65536):
            chunks.append(chunk)
        return b''.join(chunks).decode()


def status():
    keyboards = json.loads(request('j/devices'))['keyboards']
    keyboard = next(k for k in keyboards if k.get('main'))
    layout = keyboard['layout'].split(',')[keyboard['active_layout_index']].strip()
    return json.dumps({'text': f'{layout_flag(layout)} {layout}',
                       'tooltip': keyboard['active_keymap'] + ' · Click for next layout'})


def watch():
    # Subscribe before reading initial state, so no change is lost at startup.
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as events:
        events.connect(socket_path('.socket2.sock'))
        previous = status()
        print(previous, flush=True)
        with events.makefile() as lines:
            for line in lines:
                if line.startswith(('activelayout>>', 'activewindowv2>>', 'configreloaded>>')):
                    current = status()
                    if current != previous:
                        print(current, flush=True)
                        previous = current


parser = argparse.ArgumentParser(description=__doc__)
mode = parser.add_mutually_exclusive_group()
mode.add_argument('--next', action='store_true', help='Switch the active keyboard to its next layout')
mode.add_argument('--watch', action='store_true', help='Stream layout changes for Waybar')
args = parser.parse_args()

try:
    if args.next:
        response = request('/switchxkblayout current next').strip()
        raise SystemExit(0 if response == 'ok' else 1)
    if args.watch:
        watch()
    else:
        print(status(), flush=True)
except (OSError, ValueError, KeyError, IndexError, StopIteration):
    if not args.next:
        print(json.dumps({'text': '?', 'tooltip': 'Keyboard layout unavailable'}), flush=True)
    raise SystemExit(1)
