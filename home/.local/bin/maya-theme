#!/usr/bin/env python3
"""Select the shared Maya Light/Dark palette without changing wallpaper."""
from pathlib import Path
import argparse
import fcntl
import json
import os
import sys

root = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(root / 'scripts'))
from links import backup_root, ensure_alias
from themes import install_profiles, mode
from theme_runtime import toolkits, refresh

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('action', choices=['light', 'dark', 'toggle', 'status', 'apply'])
parser.add_argument('--json', action='store_true', help='Output Waybar status JSON')
parser.add_argument('--no-reload', action='store_true', help='Select palette only; skip toolkit settings and app reload commands')
args = parser.parse_args()
home = Path.home()

if args.action != 'status':
    lock = home / '.local/state/maya-dotfiles/theme.lock'
    lock.parent.mkdir(parents=True, exist_ok=True)
    with lock.open('w') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        selected = mode(home)
        if args.action == 'toggle':
            selected = 'dark' if selected == 'light' else 'light'
        elif args.action in ('light', 'dark'):
            selected = args.action
        profile = root / 'color-palette/profiles' / selected
        required = ['palette.json', 'palette.css', 'colors.conf', 'colors.lua', 'kitty.conf', 'wofi.css', 'btop.theme', 'rofi.rasi', 'tmux.conf', 'shell.zsh']
        if not all((profile / name).is_file() for name in required):
            raise SystemExit('Incomplete theme profiles. Run scripts/generate-palette.py and reinstall.')
        backup = backup_root(home)
        install_profiles(root, home, backup)
        ensure_alias(home / '.config/maya-theme/profiles' / selected,
                     home / '.config/maya-theme/current', home, backup)
        if not args.no_reload:
            for warning in toolkits(home, selected, backup):
                print(warning, file=sys.stderr)
            refresh(home)
selected = mode(home)
if args.json:
    print(json.dumps({'text': 'day' if selected == 'light' else 'night', 'class': selected,
                      'tooltip': f'{selected.title()} theme · Click for {"Dark" if selected == "light" else "Light"}'}))
else:
    print(selected)
